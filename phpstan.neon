parameters:
    level: 8
    # Base generada en local (PHP 8.5) y evaluada en CI con otra versión: las entradas que
    # cambian de número de ocurrencias no deben tumbar el job. Los errores NUEVOS sí fallan.
    reportUnmatchedIgnoredErrors: false
    paths:
        - ./
    excludePaths:
        analyseAndScan:
            - vendor
            - tests
            - node_modules (?)
    scanFiles:
        # Aquí estaba vendor/wp-phpunit/wp-phpunit/includes/functions.php: era el fichero que declaraba
        # `tests_add_filter()` y compañía para las pruebas de WordPress. El paquete se retiró el
        # 21-10-2026 (no soporta PHPUnit 10 y ya no lo usa nadie) y con él la referencia: dejarla
        # apuntando a un fichero inexistente tumba PHPStan con «Scanned file … does not exist».
    bootstrapFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
        - phpstan-bootstrap.php
    ignoreErrors:
        # ── Falsos positivos del harness de análisis (NO deuda de código) ──
        # El bootstrap define ABSPATH=/tmp/wp/ (inexistente fuera de un WP real);
        # estos require_once de wp-admin son legítimos en runtime.
        -
            message: '#Path in require_once\(\) "/tmp/wp/wp-admin/#'
            identifier: requireOnce.fileNotFound
            path: includes/Admin_Logs_List.php
        -
            message: '#Path in require_once\(\) "/tmp/wp/wp-admin/#'
            identifier: requireOnce.fileNotFound
            path: includes/Installer.php
        -
            message: '#Path in require_once\(\) "/tmp/wp/wp-admin/#'
            identifier: requireOnce.fileNotFound
            path: includes/Webhook_Manager.php
        -
            message: '#Path in require_once\(\) "/tmp/wp/wp-admin/#'
            identifier: requireOnce.fileNotFound
            path: includes/Utils.php
        -
            message: '#Path in require_once\(\) "/tmp/wp/wp-content/plugins/convoca-core/vendor/autoload.php"#'
            identifier: requireOnce.fileNotFound
            path: includes/Signature.php
        # (La exclusión de `class_exists` sobre clases de plugins hermanos en Utils.php ya no hace
        # falta: el mapa de clases se fue de ahí a Features::has(), que es el único detector.)
        # WP_DEBUG se fija a true en el bootstrap de análisis; en producción es
        # configurable. El chequeo definido&&WP_DEBUG es correcto en runtime.
        -
            message: '#Right side of && is always true#'
            identifier: booleanAnd.rightAlwaysTrue
            path: includes/Logger.php
        # check_admin_referer() muere (wp_die) si el nonce falla: el stub lo tipa
        # como siempre-true con stubs recientes; el patrón isset&&check_admin_referer
        # es el estándar WP de verificación de nonce en POST.
        -
            message: '#Right side of && is always true#'
            identifier: booleanAnd.rightAlwaysTrue
            path: includes/Admin_Templates.php
        # WP_Admin_Bar::add_node acepta WP_Admin_Bar_Node (objeto) en runtime;
        # el stub solo declara array. (En Admin/Andamiaje_Admin.php no hace falta: el nodo del
        # andamiaje se castea a array antes de añadirlo.)
        -
            message: '#Parameter \#1 \$args of method WP_Admin_Bar::add_node\(\)#'
            identifier: argument.type
            path: includes/admin-appearance.php
        # paginate_links: total como float procede de ceil(); WP lo castea a int.
        -
            message: '#Parameter \#1 \$args of function paginate_links#'
            identifier: argument.type
            path: includes/admin-global-menu.php
        # (La exclusión de class_exists/method_exists en Payments.php ya no hace falta: el gateway se
        # registra por filtro y la fachada del núcleo dejó de nombrar sus clases. Si vuelve a aparecer
        # aquí un class_exists de Convoca, es que alguien ha vuelto a acoplar el núcleo a un addon.)
