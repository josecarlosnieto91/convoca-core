parameters:
    level: 5
    paths:
        - ./
    excludePaths:
        analyseAndScan:
            - vendor (?)
            - tests (?)
            - node_modules (?)
    scanFiles:
        - vendor/wp-phpunit/wp-phpunit/includes/functions.php
    bootstrapFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
        - phpstan-bootstrap.php
